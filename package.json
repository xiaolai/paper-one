{
  "name": "paper",
  "private": true,
  "version": "0.1.1",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "build:desktop": "node scripts/sync-pdfjs-assets.mjs && TAURI_ENV_PLATFORM=darwin vite build",
    "build:ios": "node scripts/sync-pdfjs-assets.mjs && TAURI_ENV_PLATFORM=ios vite build",
    "build:android": "node scripts/sync-pdfjs-assets.mjs && TAURI_ENV_PLATFORM=android vite build",
    "build:all": "pnpm typecheck && pnpm build:desktop && pnpm build:ios && pnpm build:android",
    "preview": "vite preview",
    "typecheck": "rm -rf .types && tsc -b && node scripts/check-kernel-declarations.mjs",
    "tauri": "tauri",
    "app": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage && node scripts/check-coverage.mjs",
    "test:projects": "node scripts/check-test-projects.mjs",
    "boundaries": "node scripts/check-boundaries.mjs",
    "boundaries:selftest": "node scripts/check-boundaries.selftest.mjs",
    "boundaries:decls": "node scripts/check-kernel-declarations.mjs",
    "predev": "node scripts/sync-pdfjs-assets.mjs",
    "prebuild": "node scripts/sync-pdfjs-assets.mjs",
    "architecture:check": "node scripts/architecture-check.mjs",
    "compositions:check": "node scripts/check-compositions.mjs",
    "capability:remove": "node scripts/capability-remove.mjs",
    "verify": "node scripts/verify.mjs",
    "verify:without": "node scripts/verify-without.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "dependencies": {
    "@fontsource-variable/crimson-pro": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "foliate-js": "github:xiaolai/foliate-js#e3fde49acc53f6bc649c7f411dc6cbe6465cc182",
    "lucide-react": "^1.31.0",
    "pdfjs-dist": "6.2.108",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@hypothesi/tauri-mcp-server": "^0.12.0",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "3.2.7",
    "dependency-cruiser": "18.2.0",
    "fast-check": "4.9.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "3.2.7"
  }
}
